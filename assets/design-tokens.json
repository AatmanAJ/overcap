{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Overcap",
    "system": "Overcap Instrument",
    "signal": "#F04B2F"
  },
  "color": {
    "light": {
      "canvas": "#F3F1EA",
      "surface": "#FCFBF7",
      "ink": "#12161B",
      "body": "#343A40",
      "muted": "#5C646B",
      "rule": "#C9C7BE",
      "edge": "#747A7F",
      "track": "#DEDCD4",
      "signal": "#F04B2F",
      "warning": "#A36500",
      "critical": "#B52C2C"
