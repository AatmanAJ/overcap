    "dark": {
      "canvas": "#0E1115",
      "surface": "#151A20",
      "ink": "#F2F0E9",
      "body": "#C7C9C6",
      "muted": "#91979D",
      "rule": "#343B43",
      "edge": "#66717C",
      "track": "#232930",
      "signal": "#F04B2F",
      "warning": "#E8B04B",
      "critical": "#FF6B62"
    }
  },
  "typography": {
    "interfaceFamily": "Inter",
